{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stopped-project-guard.sh\"",
            "timeout": 10,
            "statusMessage": "멈춘 저장소인지 확인하는 중"
          }
        ]
      }
    ]
  }
}
